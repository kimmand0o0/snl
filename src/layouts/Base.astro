---
import '../styles/global.css';
import OnAir from '../components/OnAir.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = '매주 밤, 개발자들이 돌아가며 무대에 서는 스터디 — Study Night Live' } = Astro.props;
const fullTitle = title ? `${title} — SNL` : 'SNL · Study Night Live';
const path = Astro.url.pathname;
const nav = [
  { href: '/schedule', label: '편성표' },
  { href: '/episodes', label: '다시보기' },
  { href: '/cast', label: '출연진' },
  { href: '/blog', label: '블로그' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="SNL 블로그" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Black+Han+Sans&family=JetBrains+Mono:wght@400;700&family=Nanum+Pen+Script&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <div class="tally" aria-hidden="true"></div>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="SNL 홈">
          <span class="logo-mark">SNL</span>
          <span class="logo-sub">Study<br />Night Live</span>
        </a>
        <nav aria-label="주 메뉴">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <OnAir />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p class="display foot-mark">LIVE FROM YOUR TERMINAL</p>
        <p class="foot-links">
          <a href="/calendar.ics">캘린더 구독 (.ics)</a>
          <a href="/rss.xml">RSS</a>
          <a href="/cast/playground">카드 꾸미기</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .tally {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    transition: box-shadow 0.4s;
  }
  :global(body.is-live) .tally {
    box-shadow: inset 0 0 0 3px var(--onair), inset 0 0 60px #ff3d2e55;
    animation: tally 2s ease-in-out infinite;
  }
  @keyframes tally {
    50% {
      box-shadow: inset 0 0 0 3px var(--onair), inset 0 0 24px #ff3d2e33;
    }
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--stage) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .logo-mark {
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1;
    color: var(--bulb);
    letter-spacing: 0.02em;
  }
  .logo-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }
  nav {
    display: flex;
    gap: 4px;
    margin-right: auto;
  }
  nav a {
    padding: 6px 12px;
    border-radius: 99px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--cue-ink);
    background: var(--ink);
  }
  @media (max-width: 720px) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      row-gap: 8px;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .logo {
      margin-right: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0 -12px;
      overflow-x: auto;
    }
  }

  .foot {
    border-top: 1px solid var(--line);
    margin-top: 80px;
  }
  .foot-in {
    padding-top: 40px;
    padding-bottom: 48px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .foot-mark {
    font-size: clamp(28px, 6vw, 64px);
    color: var(--stage-3);
    -webkit-text-stroke: 1px var(--line);
  }
  .foot-links {
    display: flex;
    gap: 18px;
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
