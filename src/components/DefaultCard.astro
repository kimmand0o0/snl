---
import type { Member } from '../lib/data';
import { initials } from '../lib/data';

interface Props {
  member: Member;
  cohorts: number[];
  link?: boolean;
}
const { member, cohorts, link = true } = Astro.props;
const m = member.data;
const Tag = link ? 'a' : 'div';
---

<Tag
  class="card"
  href={link ? `/cast/${member.id}` : undefined}
  style={`--accent:${m.accent}`}
>
  <div class="strip">
    <span>SNL CAST</span>
    <span>{cohorts.map((c) => `${c}기`).join(' · ')}</span>
  </div>
  <div class="photo">
    {m.avatar ? <img src={m.avatar} alt="" loading="lazy" /> : <span class="ini">{initials(m.name)}</span>}
    <span class="spot" aria-hidden="true"></span>
  </div>
  <div class="lower">
    <p class="handle">@{m.handle}</p>
    <h3 class="name">{m.name}</h3>
    <p class="role">{m.role}</p>
    {m.tagline && <p class="tagline">“{m.tagline}”</p>}
    {
      m.stack.length > 0 && (
        <ul class="stack">
          {m.stack.slice(0, 4).map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</Tag>

<style>
  .card {
    --accent: var(--bulb);
    position: relative;
    display: flex;
    flex-direction: column;
    width: 320px;
    height: 460px;
    max-width: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: var(--stage-2);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.2s;
  }
  a.card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .strip {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    font: 700 11px var(--font-mono);
    letter-spacing: 0.16em;
    background: var(--accent);
    color: var(--cue-ink);
  }
  .photo {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 120%, color-mix(in oklab, var(--accent) 45%, transparent), transparent 60%),
      repeating-linear-gradient(90deg, #ffffff05 0 2px, transparent 2px 6px),
      #100f15;
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.05);
  }
  .ini {
    font-family: var(--font-ko-display);
    font-size: 88px;
    color: var(--accent);
    text-shadow: 0 8px 30px #000a;
  }
  .spot {
    position: absolute;
    inset: -40% 10% auto;
    height: 120%;
    background: radial-gradient(ellipse at top, #fff2, transparent 60%);
    pointer-events: none;
  }
  .lower {
    padding: 16px 18px 18px;
    border-top: 3px solid var(--accent);
    background: linear-gradient(#0000, #0006), var(--stage-2);
  }
  .handle {
    margin: 0;
    font: 12px var(--font-mono);
    color: var(--accent);
  }
  .name {
    margin: 2px 0 0;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
  }
  .role {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .tagline {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .stack li {
    font: 11px var(--font-mono);
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--stage-3);
    color: var(--ink-2);
  }
</style>
