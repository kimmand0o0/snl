---
/**
 * 전구로 찍은 "STUDY NIGHT LIVE" 간판.
 * 텍스트를 오프스크린 캔버스에 그린 뒤 격자로 샘플링해서 전구 위치를 만듭니다.
 * 켜질 때 왼쪽부터 순서대로 점등되고, 마우스 근처 전구는 더 밝아집니다.
 */
---

<h1 class="sr-only">Study Night Live</h1>
<canvas class="bulbs" aria-hidden="true"></canvas>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const cv of document.querySelectorAll<HTMLCanvasElement>('canvas.bulbs')) {
    const ctx = cv.getContext('2d')!;
    type Bulb = { x: number; y: number; red: boolean; delay: number; ph: number; sp: number };
    type Sprite = { c: HTMLCanvasElement; size: number };
    let bulbs: Bulb[] = [];
    let sprites: Record<'gold' | 'red' | 'off' | 'hot', Sprite> | undefined;
    let W = 0, H = 0, dpr = 1, t0 = 0, raf = 0, visible = true;
    let mouse = { x: -999, y: -999 };

    const sprite = (color: string, r: number, on: boolean): Sprite => {
      const size = Math.ceil(r * 5) * 2;
      const c = document.createElement('canvas');
      c.width = c.height = size * dpr;
      const g = c.getContext('2d')!;
      g.scale(dpr, dpr);
      const m = size / 2;
      if (on) {
        const glow = g.createRadialGradient(m, m, 0, m, m, m);
        glow.addColorStop(0, color + 'aa');
        glow.addColorStop(0.25, color + '44');
        glow.addColorStop(1, color + '00');
        g.fillStyle = glow;
        g.fillRect(0, 0, size, size);
        const core = g.createRadialGradient(m - r * 0.3, m - r * 0.3, 0, m, m, r);
        core.addColorStop(0, '#fffbe8');
        core.addColorStop(0.5, color);
        core.addColorStop(1, color);
        g.fillStyle = core;
      } else {
        g.fillStyle = '#2a2215';
      }
      g.beginPath();
      g.arc(m, m, r, 0, Math.PI * 2);
      g.fill();
      return { c, size };
    };

    const build = () => {
      W = cv.clientWidth;
      dpr = Math.min(devicePixelRatio || 1, 2);
      const lines = W < 520 ? ['STUDY', 'NIGHT', 'LIVE'] : ['STUDY NIGHT', 'LIVE'];
      const step = W < 520 ? 7 : W < 900 ? 9 : 11;
      const off = document.createElement('canvas');
      const o = off.getContext('2d', { willReadFrequently: true })!;
      let fs = 200;
      o.font = `${fs}px Anton, Impact, sans-serif`;
      const widest = Math.max(...lines.map((l) => o.measureText(l).width));
      fs = Math.floor((fs * W * 0.985) / widest);
      const lh = fs * 0.98;
      H = Math.ceil(lh * lines.length + step);
      off.width = W;
      off.height = H;
      o.font = `${fs}px Anton, Impact, sans-serif`;
      o.textBaseline = 'top';
      lines.forEach((l, i) => {
        o.fillStyle = l === 'LIVE' ? '#f00' : '#0f0';
        o.fillText(l, 0, i * lh - fs * 0.04);
      });
      const px = o.getImageData(0, 0, W, H).data;
      bulbs = [];
      for (let y = step / 2; y < H; y += step) {
        for (let x = step / 2; x < W; x += step) {
          const i = ((y | 0) * W + (x | 0)) * 4;
          if (px[i + 3] > 140)
            bulbs.push({
              x,
              y,
              red: px[i] > px[i + 1],
              delay: (x / W) * 0.9 + Math.random() * 0.25,
              ph: Math.random() * 6.28,
              sp: 0.6 + Math.random() * 1.6,
            });
        }
      }
      cv.width = W * dpr;
      cv.height = H * dpr;
      cv.style.height = `${H}px`;
      const r = step * 0.36;
      sprites = {
        gold: sprite('#ffc531', r, true),
        red: sprite('#ff3d2e', r, true),
        off: sprite('', r, false),
        hot: sprite('#fff3c4', r, true),
      };
      t0 = performance.now();
    };

    const frame = (now: number) => {
      if (!sprites) return;
      const t = (now - t0) / 1000;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const s = sprites.off.size;
      for (const b of bulbs) ctx.drawImage(sprites.off.c, b.x - s / 2, b.y - s / 2, s, s);
      ctx.globalCompositeOperation = 'lighter';
      for (const b of bulbs) {
        let a = reduce ? 1 : Math.min(1, Math.max(0, (t - b.delay * 1.3) / 0.12));
        if (!reduce && a === 1) a = 0.82 + 0.18 * Math.sin(t * b.sp * 2 + b.ph);
        if (!reduce && b.red) a *= 0.75 + 0.25 * Math.max(0, Math.sin(t * 3.2));
        const near = Math.max(0, 1 - Math.hypot(b.x - mouse.x, b.y - mouse.y) / 110);
        const sp = b.red ? sprites.red : sprites.gold;
        ctx.globalAlpha = a;
        ctx.drawImage(sp.c, b.x - sp.size / 2, b.y - sp.size / 2, sp.size, sp.size);
        if (near > 0) {
          ctx.globalAlpha = near * a;
          ctx.drawImage(sprites.hot.c, b.x - sp.size / 2, b.y - sp.size / 2, sp.size, sp.size);
        }
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (!reduce && visible) raf = requestAnimationFrame(frame);
    };

    const loop = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(frame);
    };

    cv.addEventListener('pointermove', (e) => {
      const r = cv.getBoundingClientRect();
      mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
    });
    cv.addEventListener('pointerleave', () => (mouse = { x: -999, y: -999 }));
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) loop();
    }).observe(cv);

    let rt: number | undefined;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (cv.clientWidth === W) return;
        build();
        t0 -= 10_000; // 리사이즈 땐 점등 애니메이션 생략
        loop();
      }, 150);
    });

    document.fonts
      .load('100px Anton')
      .catch(() => {})
      .then(() => {
        build();
        loop();
      });
  }
</script>

<style>
  .bulbs {
    display: block;
    width: 100%;
    margin: clamp(14px, 3vw, 28px) 0 clamp(14px, 3vw, 26px);
    cursor: crosshair;
  }
</style>
