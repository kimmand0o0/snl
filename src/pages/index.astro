---
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import PostList from '../components/PostList.astro';
import BulbSign from '../components/BulbSign.astro';
import { loadAll, formatDate, slate, ymd } from '../lib/data';

const d = await loadAll(Astro.locals.supabase);
const { next, currentSeason, seasonOf, presenterOf, timeOf, memberById, cohortsOf } = d;
const cast = currentSeason?.data.cast.map((c) => memberById.get(c.id)!) ?? d.members;
const recent = d.episodes.filter((e) => e.data.status === 'done').slice(-4).reverse();
const posts = d.posts.slice(0, 4);
const authorOf = (p: (typeof posts)[number]) => memberById.get(p.data.author.id)!;
const nextPresenter = next && presenterOf(next);
const countdown = d.upcoming.map((e) => ({
  d: ymd(e.data.date),
  t: timeOf(e),
  s: slate(seasonOf(e).data.number, e.data.number),
  who: presenterOf(e).data.name,
}));
---

<Base>
  <section class="hero">
    <div class="wrap">
      <div class="marquee">
        <div class="marquee-in">
          <div class="hero-top">
            <p class="eyebrow">
              Live from your terminal{currentSeason ? ` · ${currentSeason.data.number}기 「${currentSeason.data.title}」` : ''}
            </p>
            <span class="rec"><i></i>REC{currentSeason && ` · ${currentSeason.data.place}`}</span>
          </div>
          <BulbSign />
          <div class="hero-foot">
            <p class="lede">
              매주 밤, 한 명씩 돌아가며 무대에 섭니다.<br />
              <b>준비한 건 발표 하나, 남는 건 기록 전부.</b>
            </p>
            <div class="count" data-countdown={JSON.stringify(countdown)}>
              <p class="count-k">NEXT EPISODE IN</p>
              <p class="count-v">--</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    next && nextPresenter && (
      <section class="wrap tonight">
        <div class="cue next-cue">
          <p class="cue-top">
            <span class="slate">{slate(seasonOf(next).data.number, next.data.number)}</span>
            <span>NEXT ON SNL</span>
          </p>
          <p class="when">
            {formatDate(next.data.date)} <b>{timeOf(next)}</b> · {seasonOf(next).data.place}
          </p>
          <h2 class="cue-title">{next.data.title}</h2>
          {next.data.summary && <p class="cue-sum">{next.data.summary}</p>}
          <p class="cue-host">
            <span>오늘의 호스트</span>
            <b>{nextPresenter.data.name}</b>
          </p>
          <span class="scribble" aria-hidden="true">← {timeOf(next)} 정각 큐!</span>
          <div class="cue-actions">
            <a class="btn primary" href={`/episodes/${next.id}`}>
              에피소드 보기
            </a>
            <a class="btn dark" href="/calendar.ics">
              캘린더에 추가
            </a>
          </div>
        </div>
        <div class="next-card">
          <ProfileCard member={nextPresenter} cohorts={cohortsOf(nextPresenter.id)} />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{currentSeason ? `${currentSeason.data.number}기 출연진` : 'Cast'}</p>
          <h2>{currentSeason?.data.title ?? '출연진'}</h2>
        </div>
        <a class="more" href="/cast">전체 출연진 →</a>
      </div>
    </div>
    {
      cast.length ? (
        <div class="cast-rail">
          {cast.map((m) => <ProfileCard member={m} cohorts={cohortsOf(m.id)} />)}
        </div>
      ) : (
        <p class="wrap empty">
          아직 출연진이 없어요. 초대 코드를 받았다면 <a href="/join">출연 신청</a>부터!
        </p>
      )
    }
  </section>

  <section class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Replays</p>
        <h2>지난 방송</h2>
      </div>
      <a class="more" href="/episodes">전체 아카이브 →</a>
    </div>
    <div class="rows">
      {
        recent.map((e) => (
          <EpisodeRow episode={e} season={seasonOf(e)} presenter={presenterOf(e)} time={timeOf(e)} />
        ))
      }
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Backstage notes</p>
        <h2>최근 글</h2>
      </div>
      <a class="more" href="/blog">블로그 →</a>
    </div>
    <PostList posts={posts} authorOf={authorOf} />
  </section>
</Base>

<script>
  const HOUR = 3600_000;
  const kst = (d: string, t: string) => Date.parse(`${d}T${t}:00+09:00`);
  const pad = (n: number) => String(n).padStart(2, '0');
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const list: { d: string; t: string; s: string; who: string }[] = JSON.parse(el.dataset.countdown!);
    const k = el.querySelector('.count-k')!;
    const v = el.querySelector('.count-v')!;
    const tick = () => {
      const now = Date.now();
      const next = list.find((e) => kst(e.d, e.t) + 2 * HOUR > now);
      if (!next) {
        k.textContent = 'SEASON BREAK';
        v.textContent = '휴방';
        return;
      }
      const left = kst(next.d, next.t) - now;
      if (left <= 0) {
        k.textContent = `NOW ON AIR · ${next.s}`;
        v.textContent = '● LIVE';
        return;
      }
      const days = Math.floor(left / (24 * HOUR));
      k.textContent = `NEXT · ${next.s} · ${next.who}`;
      v.innerHTML = `${days ? `${days}<small>일</small>` : ''}${pad(Math.floor(left / HOUR) % 24)}:${pad(Math.floor(left / 60_000) % 60)}:${pad(Math.floor(left / 1000) % 60)}`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 0;
  }
  /* 전구가 둘러진 극장 간판 */
  .marquee {
    position: relative;
    padding: 18px;
    border-radius: 28px;
    background: #17130a;
    box-shadow:
      inset 0 0 0 2px #3a2e10,
      0 40px 120px -40px #ffc53140;
  }
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 18px;
    background: radial-gradient(circle, var(--bulb) 0 3.5px, #ffc53155 4.5px, transparent 7px) 0 0 / 26px 26px;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }
  .marquee::after {
    background-position: 13px 13px;
    background-image: radial-gradient(circle, #fff6d0 0 3.5px, #ffc53166 4.5px, transparent 7px);
    animation: chase 1.2s steps(1) infinite;
  }
  @keyframes chase {
    50% {
      opacity: 0.15;
    }
  }
  .marquee-in {
    position: relative;
    border-radius: 14px;
    padding: clamp(28px, 6vw, 72px) clamp(20px, 5vw, 64px);
    background:
      radial-gradient(800px 300px at 30% 0%, #ffc5311c, transparent 70%),
      var(--stage);
    overflow: hidden;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-top .eyebrow {
    margin: 0;
  }
  .rec {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 12px var(--font-mono);
    letter-spacing: 0.16em;
    color: var(--ink-2);
  }
  .rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--onair);
    animation: rec 1.3s ease-in-out infinite;
  }
  @keyframes rec {
    50% {
      opacity: 0.3;
    }
  }
  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .lede b {
    color: var(--ink);
  }
  .count {
    text-align: right;
  }
  .count p {
    margin: 0;
  }
  .count-k {
    font: 700 11px var(--font-mono);
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 4px !important;
  }
  .count-v {
    font: 400 clamp(34px, 5vw, 56px) / 1 var(--font-display);
    font-variant-numeric: tabular-nums;
    color: var(--bulb);
    text-shadow: 0 0 24px #ffc53166;
  }
  .count-v :global(small) {
    font-size: 0.45em;
    color: var(--ink-2);
    margin: 0 0.2em 0 0.1em;
  }
  @media (max-width: 620px) {
    .count {
      text-align: left;
    }
  }
  .lede {
    max-width: 30em;
    font-size: clamp(16px, 2vw, 20px);
    color: var(--ink-2);
    margin: 0;
  }

  .tonight {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .next-cue {
    position: relative;
    padding: clamp(26px, 4vw, 48px) clamp(22px, 4vw, 48px) clamp(26px, 4vw, 44px) clamp(40px, 6vw, 76px);
    transform: rotate(-0.8deg);
    background-image:
      linear-gradient(90deg, transparent clamp(26px, 4.5vw, 56px), #e2483566 0 calc(clamp(26px, 4.5vw, 56px) + 2px), transparent 0),
      repeating-linear-gradient(transparent 0 31px, #3b6fd424 31px 32px);
  }
  /* 마스킹 테이프 */
  .next-cue::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 50%;
    width: 110px;
    height: 26px;
    margin-left: -55px;
    background: #f2e8b8b0;
    transform: rotate(2deg);
    box-shadow: 0 1px 2px #0002;
  }
  .scribble {
    position: absolute;
    right: clamp(14px, 4vw, 40px);
    top: clamp(48px, 7vw, 70px);
    font: 400 26px / 1.1 var(--font-pen);
    color: var(--pen);
    transform: rotate(-6deg);
    pointer-events: none;
  }
  @media (max-width: 560px) {
    .scribble {
      display: none;
    }
  }
  .cue-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font: 700 12px var(--font-mono);
    letter-spacing: 0.18em;
    color: #b0331f;
  }
  .when {
    margin: 18px 0 4px;
    font: 14px var(--font-mono);
  }
  .cue-title {
    font-family: var(--font-ko-display);
    font-weight: 400;
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.15;
    margin: 0 0 12px;
  }
  .cue-sum {
    margin: 0 0 16px;
    color: #4b4430;
    max-width: 36em;
  }
  .cue-host {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 22px;
  }
  .cue-host span {
    font-size: 13px;
    color: #6b6248;
  }
  .cue-host b {
    font-size: 22px;
  }
  .cue-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .btn.dark {
    background: var(--cue-ink);
    color: var(--cue);
    border-color: var(--cue-ink);
  }
  @media (max-width: 860px) {
    .tonight {
      grid-template-columns: 1fr;
    }
    .next-card {
      justify-self: center;
    }
  }

  .cast-rail {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding: 8px var(--edge) 24px;
    scroll-padding-inline: var(--edge);
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .cast-rail > :global(*) {
    flex: none;
    scroll-snap-align: start;
  }
  .rows {
    border-top: 1px solid var(--line);
  }
  .empty {
    color: var(--ink-2);
  }
</style>
