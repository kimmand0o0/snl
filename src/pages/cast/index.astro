---
import Base from '../../layouts/Base.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import { loadAll } from '../../lib/data';

const d = await loadAll(Astro.locals.supabase);
const { members, seasons, cohortsOf, currentSeason } = d;
const sorted = [...members].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ko'));
---

<Base title="출연진" description="SNL 스터디 멤버 프로필 카드">
  <section class="wrap head">
    <p class="eyebrow">Cast</p>
    <h1 class="display big">출연진</h1>
    <div class="bar">
      <div class="filters" role="group" aria-label="기수 필터">
        <button type="button" class="f" aria-pressed="true" data-season="all">전체</button>
        {
          seasons.map((s) => (
            <button type="button" class="f" aria-pressed="false" data-season={s.data.number}>
              {s.data.number}기{s.id === currentSeason?.id && ' · ON'}
            </button>
          ))
        }
      </div>
      <a class="btn" href={Astro.locals.me ? '/cast/playground' : '/join'}>{Astro.locals.me ? '✦ 내 카드 꾸미기' : '✦ 출연 신청'}</a>
    </div>
  </section>

  <section class="wrap">
    {!sorted.length && <p class="empty">아직 등록한 출연진이 없어요. 초대 코드가 있다면 첫 번째 출연자가 되어 주세요!</p>}
    <ul class="grid">
      {
        sorted.map((m) => (
          <li data-cohorts={cohortsOf(m.id).join(' ')}>
            <ProfileCard member={m} cohorts={cohortsOf(m.id)} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters .f');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const s = b.dataset.season!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('.grid li').forEach((li) => {
        li.hidden = s !== 'all' && !(li.dataset.cohorts ?? '').split(' ').includes(s);
      });
    }),
  );
</script>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 64px);
    padding-bottom: 32px;
  }
  .big {
    font-family: var(--font-ko-display);
    font-size: clamp(48px, 9vw, 96px);
    margin: 8px 0 20px;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .f {
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    font: 600 14px var(--font-body);
    cursor: pointer;
  }
  .f[aria-pressed='true'] {
    background: var(--ink);
    color: var(--cue-ink);
    border-color: var(--ink);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, 320px);
    justify-content: center;
    gap: 28px;
  }
  @media (max-width: 400px) {
    .grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
  .empty {
    color: var(--ink-2);
    padding: 40px 0;
  }
</style>
