---
import Base from '../layouts/Base.astro';
import { safeNext } from '../lib/forms';

const next = safeNext(Astro.url.searchParams.get('next') ?? '/');
if (Astro.locals.user) return Astro.redirect(Astro.locals.me ? next : `/join?next=${encodeURIComponent(next)}`);
---

<Base title="로그인">
  <section class="wrap login">
    <div class="cue box">
      <p class="cue-top"><span class="slate">BACKSTAGE</span><span>출연자 전용</span></p>
      <h1>무대 뒤로 들어가기</h1>
      <p class="sub">로그인하면 프로필·카드를 꾸미고, 발표 자료를 올리고, 글을 쓸 수 있어요.</p>
      <form method="post" action="/auth/signin" class="btns">
        <input type="hidden" name="next" value={next} />
        <button class="btn dark" name="provider" value="github">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          GitHub로 계속하기
        </button>
        <button class="btn light" name="provider" value="google">
          <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          Google로 계속하기
        </button>
      </form>
      <p class="fine">처음이라면 로그인 후 스터디에서 받은 <b>초대 코드</b>를 입력하면 출연진으로 등록돼요.</p>
    </div>
  </section>
</Base>

<style>
  .login {
    display: grid;
    place-items: center;
    padding-top: clamp(40px, 8vw, 96px);
  }
  .box {
    width: min(100%, 460px);
    padding: clamp(28px, 5vw, 44px);
    transform: rotate(-0.6deg);
  }
  .cue-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font: 700 12px var(--font-mono);
    letter-spacing: 0.18em;
    color: #b0331f;
  }
  h1 {
    font-family: var(--font-ko-display);
    font-weight: 400;
    font-size: clamp(32px, 6vw, 44px);
    margin: 18px 0 8px;
  }
  .sub {
    margin: 0 0 24px;
    color: #4b4430;
  }
  .btns {
    display: grid;
    gap: 10px;
  }
  .btns .btn {
    justify-content: center;
    padding: 13px 18px;
    font-size: 15px;
  }
  .btn.dark {
    background: var(--cue-ink);
    color: var(--cue);
    border-color: var(--cue-ink);
  }
  .btn.light {
    background: #fff;
    color: #1f1f1f;
    border-color: #0002;
  }
  .fine {
    margin: 20px 0 0;
    font-size: 13px;
    color: #6b6248;
  }
</style>
