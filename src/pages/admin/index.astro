---
import Base from '../../layouts/Base.astro';
import { loadAll, formatDate } from '../../lib/data';
import { back, explain, opt, str } from '../../lib/forms';

const db = Astro.locals.supabase;
const me = Astro.locals.me!;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action');
  if (action === 'invite') {
    const code = str(fd, 'code') || crypto.randomUUID().slice(0, 8);
    const { error } = await db.from('settings').update({ invite_code: code }).eq('id', true);
    return back(Astro.url, error ? explain(error) : `초대 코드를 바꿨어요: ${code}`);
  }
  if (action === 'admin') {
    const { error } = await db.rpc('set_admin', { target: str(fd, 'id'), value: fd.get('value') === 'true' });
    return back(Astro.url, error ? explain(error) : '권한을 바꿨어요.', undefined, '#members');
  }
  if (action === 'remove-member') {
    if (str(fd, 'id') === me.id) return back(Astro.url, '본인은 내보낼 수 없어요.');
    const { error } = await db.from('members').delete().eq('id', str(fd, 'id'));
    return back(Astro.url, error ? explain(error) : '출연진에서 내보냈어요.', undefined, '#members');
  }
  if (action === 'season') {
    const number = Number(str(fd, 'number'));
    const { error } = await db.from('seasons').insert({
      number,
      title: str(fd, 'title'),
      theme: opt(fd, 'theme'),
      start_date: str(fd, 'start'),
      end_date: opt(fd, 'end'),
      time: str(fd, 'time') || '20:00',
      place: str(fd, 'place') || '온라인',
    });
    if (error) return back(Astro.url, explain(error));
    return back(Astro.url, `${number}기를 만들었어요. 출연진과 발표 순서를 정해 주세요.`, `/admin/seasons/${number}`);
  }
  return back(Astro.url, '알 수 없는 요청이에요.');
}

const { data: settings } = await db.from('settings').select('invite_code').maybeSingle();
const d = await loadAll(db);
const nextNumber = (d.seasons.at(-1)?.data.number ?? 0) + 1;
---

<Base title="관리">
  <section class="wrap head">
    <p class="eyebrow">Control room</p>
    <h1 class="display big">관리</h1>
  </section>

  <section class="wrap cols">
    <div class="panel">
      <h2>초대 코드</h2>
      <p class="code"><code data-code>{settings?.invite_code}</code> <button type="button" class="btn" data-copy>복사</button></p>
      <p class="muted">이 코드를 아는 사람은 로그인 후 출연진으로 등록할 수 있어요. 새 기수 모집이 끝나면 바꿔 두세요.</p>
      <form method="post" class="actions">
        <input type="hidden" name="action" value="invite" />
        <input name="code" placeholder="비우면 무작위" style="max-width: 220px" />
        <button class="btn">코드 바꾸기</button>
      </form>
    </div>

    <div class="panel">
      <h2>새 기수</h2>
      <form method="post" class="form">
        <input type="hidden" name="action" value="season" />
        <div class="row2">
          <label class="field"><span>기수</span><input name="number" type="number" min="1" required value={nextNumber} /></label>
          <label class="field"><span>이름</span><input name="title" required placeholder="분산 시스템의 밤" /></label>
        </div>
        <label class="field"><span>주제 (선택)</span><input name="theme" /></label>
        <div class="row2">
          <label class="field"><span>시작일</span><input name="start" type="date" required /></label>
          <label class="field"><span>종료일 (선택)</span><input name="end" type="date" /></label>
        </div>
        <div class="row2">
          <label class="field"><span>시간</span><input name="time" type="time" value="20:00" /></label>
          <label class="field"><span>장소</span><input name="place" value="온라인" /></label>
        </div>
        <div class="actions"><button class="btn primary">만들기</button></div>
      </form>
    </div>
  </section>

  <section class="wrap section">
    <h2>기수</h2>
    {
      d.seasons.length ? (
        <ul class="list">
          {[...d.seasons].reverse().map((s) => (
            <li>
              <a href={`/admin/seasons/${s.data.number}`}>
                <b>{s.data.number}기</b> {s.data.title}
              </a>
              <span class="muted">
                {formatDate(s.data.start, false)} · 출연 {s.data.cast.length}명 ·{' '}
                {d.episodes.filter((e) => e.data.season.id === s.id).length}회
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">아직 기수가 없어요. 위에서 첫 기수를 만들어 주세요.</p>
      )
    }
  </section>

  <section class="wrap" id="members">
    <h2>출연진 {d.members.length}명</h2>
    <ul class="list">
      {
        d.members.map((m) => (
          <li>
            <a href={`/cast/${m.id}`}>
              <b>{m.data.name}</b> <span class="muted">/{m.id}</span>
              {m.isAdmin && <span class="chip">관리자</span>}
            </a>
            <span class="actions">
              {m.uid !== me.id && (
                <>
                  <form method="post">
                    <input type="hidden" name="action" value="admin" />
                    <input type="hidden" name="id" value={m.uid} />
                    <input type="hidden" name="value" value={String(!m.isAdmin)} />
                    <button class="btn sm">{m.isAdmin ? '관리자 해제' : '관리자 지정'}</button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="action" value="remove-member" />
                    <input type="hidden" name="id" value={m.uid} />
                    <button class="btn sm danger" data-confirm={`${m.data.name}님을 출연진에서 내보낼까요? 프로필과 글이 지워져요.`}>
                      내보내기
                    </button>
                  </form>
                </>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  btn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(document.querySelector('[data-code]')!.textContent ?? '');
    btn.textContent = '복사됨 ✓';
    setTimeout(() => (btn.textContent = '복사'), 1500);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((b) =>
    b.addEventListener('click', (ev) => {
      if (!confirm(b.dataset.confirm)) ev.preventDefault();
    }),
  );
</script>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 64px);
    padding-bottom: 24px;
  }
  .big {
    font-family: var(--font-ko-display);
    font-size: clamp(44px, 8vw, 80px);
    margin: 8px 0 0;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 20px;
    align-items: start;
  }
  .code {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .code code {
    font: 700 22px var(--font-mono);
    color: var(--bulb);
    letter-spacing: 0.08em;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .list a {
    text-decoration: none;
  }
  .btn.sm {
    padding: 4px 12px;
    font-size: 12px;
  }
</style>
