---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import Materials from '../../components/Materials.astro';
import { loadAll, formatDate, slate, type Episode } from '../../lib/data';

export async function getStaticPaths() {
  const { episodes } = await loadAll();
  return episodes.map((e) => ({ params: { id: e.id }, props: { id: e.id } }));
}

const d = await loadAll();
const idx = d.episodes.findIndex((e) => e.id === Astro.props.id);
const e = d.episodes[idx] as Episode;
const season = d.seasonOf(e);
const p = d.presenterOf(e);
const prev = d.episodes[idx - 1];
const nxt = d.episodes[idx + 1];
const related = d.posts.filter((post) => post.data.episode?.id === e.id);
const { Content } = await render(e);
const hasBody = Boolean(e.body?.trim());
const statusLabel = { scheduled: '방송 예정', done: '방송 완료', skipped: '휴방' }[e.data.status];
---

<Base title={`${slate(season.data.number, e.data.number)} ${e.data.title}`} description={e.data.summary}>
  <article class="wrap ep">
    <header class="ep-head">
      <p class="top">
        <span class="slate">{slate(season.data.number, e.data.number)}</span>
        <a href={`/schedule#${season.id}`} class="season">{season.data.number}기 · {season.data.title}</a>
        <span class:list={['status', e.data.status]}>{statusLabel}</span>
      </p>
      <h1 class="title">{e.data.title}</h1>
      <p class="when">
        {formatDate(e.data.date)} {d.timeOf(e)} · {season.data.place} · 호스트 <a href={`/cast/${p.id}`}>{p.data.name}</a>
      </p>
      {e.data.summary && <p class="summary">{e.data.summary}</p>}
      {
        e.data.tags.length > 0 && (
          <p class="tags">
            {e.data.tags.map((t) => (
              <span class="chip">#{t}</span>
            ))}
          </p>
        )
      }
    </header>

    <div class="layout">
      <div class="main">
        <h2 class="h">발표 자료</h2>
        <Materials items={e.data.materials} stage />

        {
          hasBody && (
            <>
              <h2 class="h">방송 노트</h2>
              <div class="prose">
                <Content />
              </div>
            </>
          )
        }

        {
          related.length > 0 && (
            <>
              <h2 class="h">관련 글</h2>
              <ul class="related">
                {related.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}`}>✎ {post.data.title}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
      <aside class="side">
        <ProfileCard member={p} cohorts={d.cohortsOf(p.id)} />
      </aside>
    </div>

    <nav class="pager" aria-label="이전/다음 회차">
      {
        prev ? (
          <a href={`/episodes/${prev.id}`}>
            <small>← 이전 회차</small>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        nxt && (
          <a href={`/episodes/${nxt.id}`} class="r">
            <small>다음 회차 →</small>
            {nxt.data.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .ep {
    padding-top: clamp(32px, 6vw, 64px);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 14px;
  }
  .season {
    color: var(--ink-2);
    text-decoration: none;
  }
  .status {
    font: 700 11px var(--font-mono);
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 5px;
    background: var(--stage-3);
    color: var(--ink-2);
  }
  .status.scheduled {
    background: var(--onair);
    color: #fff;
  }
  .title {
    font-family: var(--font-ko-display);
    font-weight: 400;
    font-size: clamp(36px, 6vw, 68px);
    line-height: 1.12;
    margin: 18px 0 12px;
    max-width: 18em;
  }
  .when {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
  }
  .summary {
    font-size: 19px;
    max-width: 40em;
    margin: 18px 0 0;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    margin-top: 40px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 88px;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      justify-self: center;
    }
  }
  .h {
    font: 700 12px var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bulb);
    margin: 40px 0 14px;
  }
  .h:first-child {
    margin-top: 0;
  }
  .related {
    padding-left: 0;
    list-style: none;
  }
  .related a {
    color: var(--bulb);
    font-weight: 600;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-weight: 700;
    max-width: 45%;
  }
  .pager .r {
    text-align: right;
    margin-left: auto;
  }
  .pager small {
    font: 12px var(--font-mono);
    color: var(--ink-3);
  }
</style>
